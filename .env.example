# ══════════════════════════════════════════════════════════════════════════════
# .env.example — Mail Service
# ══════════════════════════════════════════════════════════════════════════════
# Copia este archivo como ".env" en la raíz del proyecto y completa
# con tus valores reales. El archivo .env NUNCA debe subirse a GitHub.
#
#   cp .env.example .env
#
# ══════════════════════════════════════════════════════════════════════════════

# ── Perfil de Spring Boot ────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Base de datos PostgreSQL ─────────────────────────────────────────────────
POSTGRES_DB=mailservice
POSTGRES_USER=mailuser
POSTGRES_PASSWORD=

# ── Puertos expuestos ────────────────────────────────────────────────────────
POSTGRES_PORT=5432
APP_PORT=8081

# ── Servidor SMTP ────────────────────────────────────────────────────────────
# Ejemplos: smtp-relay.brevo.com | smtp.gmail.com | smtp.sendgrid.net
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_AUTH=true
SPRING_MAIL_STARTTLS=true

# ── Remitente de los emails ──────────────────────────────────────────────────
MAIL_FROM=no-reply@tudominio.com
MAIL_FROM_NAME=Mi Empresa

# ── API Key para autenticación de la API REST ────────────────────────────────
# Generar con:  openssl rand -hex 32
API_KEY=

# ── Credenciales del Panel de Administración ─────────────────────────────────
# Generar password con:  openssl rand -base64 24
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Cron de depuración de logs ───────────────────────────────────────────────
# Formato: seg min hora dia-mes mes dia-semana
# Default: 1 de enero y 1 de julio a las 03:00 AM (cada 6 meses)
PURGE_CRON=0 0 3 1 1,7 *
